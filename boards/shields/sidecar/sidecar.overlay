#include <behaviors/input_processor_absolute_to_relative.dtsi>
#include <behaviors/input_processor_gestures.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;

    glidepoint: glidepoint@0 {
        compatible = "cirque,pinnacle";
        reg = <0>;
        spi-max-frequency = <10000000>;
        status = "okay";

        dr-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        absolute-mode;
        absolute-mode-scale-to-width = <1024>;
        absolute-mode-scale-to-height = <1024>;
        absolute-mode-clamp-min-x = <0>;
        absolute-mode-clamp-max-x = <2047>;
        absolute-mode-clamp-min-y = <0>;
        absolute-mode-clamp-max-y = <1535>;
    };
};

/ {
    chosen {
        zmk,kscan = &sidecar_kscan;
        zmk,physical-layout = &sidecar_layout;
    };

    sidecar_kscan: sidecar_kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    sidecar_transform: sidecar_transform {
        compatible = "zmk,matrix-transform";
        columns = <1>;
        rows = <1>;
        map = <RC(0,0)>;
    };

    sidecar_layout: sidecar_layout {
        compatible = "zmk,physical-layout";
        display-name = "Sidecar";
        transform = <&sidecar_transform>;
        kscan = <&sidecar_kscan>;
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        device = <&glidepoint>;
        input-processors = <&zip_gestures &zip_absolute_to_relative>;
    };
};
