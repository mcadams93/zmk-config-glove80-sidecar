#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;

    glidepoint: glidepoint@0 {
        compatible = "cirque,pinnacle2";
        reg = <0>;
        spi-max-frequency = <1000000>;
        status = "okay";

        data-ready-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;

        data-mode = "absolute";
        sensitivity = "1x";
        clipping-enable;
        active-range-x-min = <128>;
        active-range-x-max = <1920>;
        active-range-y-min = <64>;
        active-range-y-max = <1472>;

        absolute-relative-multiplier = <12>;
        absolute-relative-divisor = <40>;
        absolute-touch-min-z = <12>;

        primary-tap-enable;
        absolute-tap-max-ms = <200>;
        absolute-tap-max-movement = <80>;
        absolute-tap-click-ms = <10>;
        absolute-tap-drag-enable;
        absolute-tap-drag-timeout-ms = <300>;

        absolute-secondary-tap-area-width = <520>;
        absolute-secondary-tap-area-height = <420>;

        absolute-right-edge-scroll-enable;
        absolute-scroll-zone = <240>;
        absolute-scroll-divisor = <100>;

        invert-x;
    };
};

/ {
    chosen {
        zmk,kscan = &sidecar_kscan;
        zmk,physical-layout = &sidecar_layout;
    };

    sidecar_kscan: sidecar_kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    sidecar_transform: sidecar_transform {
        compatible = "zmk,matrix-transform";
        columns = <1>;
        rows = <1>;
        map = <RC(0,0)>;
    };

    sidecar_layout: sidecar_layout {
        compatible = "zmk,physical-layout";
        display-name = "Sidecar";
        transform = <&sidecar_transform>;
        kscan = <&sidecar_kscan>;
    };

    glidepoint_transform: glidepoint_transform {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <1>;
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        device = <&glidepoint>;
        input-processors = <&glidepoint_transform INPUT_TRANSFORM_X_INVERT>;
    };
};
