#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/input_processor_absolute_to_relative.dtsi>
#include <behaviors/input_processor_gestures.dtsi>
#include <input/processors.dtsi>

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;

    glidepoint: glidepoint@0 {
        compatible = "cirque,pinnacle";
        reg = <0>;
        spi-max-frequency = <1000000>;
        status = "okay";

        data-ready-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;

        data-mode = "absolute";
        clipping-enable;
        scaling-enable;
        active-range-x-min = <128>;
        active-range-x-max = <1920>;
        active-range-y-min = <64>;
        active-range-y-max = <1472>;
        scaling-x-resolution = <1024>;
        scaling-y-resolution = <1024>;
    };
};

&zip_gestures {
    circular-scroll;
    tap-detection;
    tap-timeout-ms = <150>;
    circular-scroll-rim-percent = <5>;
};

/ {
    chosen {
        zmk,kscan = &sidecar_kscan;
        zmk,physical-layout = &sidecar_layout;
    };

    sidecar_kscan: sidecar_kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    sidecar_transform: sidecar_transform {
        compatible = "zmk,matrix-transform";
        columns = <1>;
        rows = <1>;
        map = <RC(0,0)>;
    };

    sidecar_layout: sidecar_layout {
        compatible = "zmk,physical-layout";
        display-name = "Sidecar";
        transform = <&sidecar_transform>;
        kscan = <&sidecar_kscan>;
    };

    glidepoint_transform: glidepoint_transform {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <1>;
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        device = <&glidepoint>;
        input-processors = <&zip_gestures &zip_absolute_to_relative &zip_xy_scaler 1 1 &zip_scroll_scaler 1 3 &glidepoint_transform INPUT_TRANSFORM_X_INVERT>;
    };
};
